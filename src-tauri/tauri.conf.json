{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZ Hanseikai",
  "identifier": "dev.ez-hanseikai.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0f1115",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: ezh: http://ezh.localhost; font-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ezh: http://ezh.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzREIyRTVEOTg3OTQxMjEKUldRaFFYbVlYUzdiMDFQTllyck81ekRpdHpuckJZK0VXUFFRbFRsS0RVOGtUTHVaSEZIbFNFdzIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
