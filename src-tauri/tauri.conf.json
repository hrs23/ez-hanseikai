{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZ Hanseikai",
  "version": "0.1.2",
  "identifier": "dev.ez-hanseikai.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EZ Hanseikai",
        "width": 960,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzREIyRTVEOTg3OTQxMjEKUldRaFFYbVlYUzdiMDFQTllyck81ekRpdHpuckJZK0VXUFFRbFRsS0RVOGtUTHVaSEZIbFNFdzIK",
      "endpoints": [
        "https://github.com/hrs23/ez-hanseikai/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
